# Copy to infra/.env and set real values.

COMPOSE_PROJECT_NAME=ai

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5
DATABASE_URL=postgresql://app:change_me@db:5432/app
REDIS_URL=redis://redis:6379/0

BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_TLS_PORT=443

# Frontend public edge stays same-origin via nginx.
NEXT_PUBLIC_API_BASE_URL=/api
API_BASE_URL=http://nginx
ADMIN_PANEL_URL=http://nginx
INTERNAL_API_TOKEN=change_me_internal_token
INTERNAL_API_ALLOWED_SCOPES=jobs.run,jobs.retry,worker.run_once,module_jobs.run_once,events.outbox.run_once,runtime.rehydrate,scheduler.run_once,notifications.read,webhooks.retry_failed,webhooks.failed_deliveries.read,analytics.kpis.refresh,platform.kpi.refresh_all,platform.kpi.refresh_tenant,platform.automation.evaluate,context.student.read,platform.ai_copilot.rebuild_cache
PLATFORM_ADMIN_LOGIN=platform_admin
PLATFORM_ADMIN_PASSWORD=change_me_platform_admin_password_12_chars
PLATFORM_ADMIN_EMAIL=platform_admin@platform.local
PLATFORM_ADMIN_UPDATE_PASSWORD=true
PLATFORM_ADMIN_FORCE_PASSWORD_CHANGE=false
E2E_SMOKE_USERNAME=smoke-admin
E2E_SMOKE_PASSWORD=change_me_smoke_password

# Auth and security
JWT_SECRET=change_me_jwt_secret
INTEGRATIONS_ENCRYPTION_KEY=change_me_integration_key_32_chars_min
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_MINUTES=10080
AUTH_ACCESS_COOKIE_NAME=app_access_token
AUTH_REFRESH_COOKIE_NAME=app_refresh_token
AUTH_ACCESS_COOKIE_SAMESITE=lax
AUTH_CSRF_PROTECTION_ENABLED=true
AUTH_CSRF_COOKIE_NAME=app_csrf_token
AUTH_CSRF_COOKIE_SAMESITE=lax
AUTH_DEV_DEMO_COMPATIBILITY=false
AUTH_ALLOW_LEGACY_HEADERS=false
RBAC_ALLOW_DEV_FALLBACK=false
BILLING_DB_ONLY_MODE=true
AUTH_REVOCATION_REDIS_URL=
TRUSTED_HOSTS=localhost,127.0.0.1,backend,nginx
APP_ENV=development
METRICS_TOKEN=change_me_metrics_token
METRICS_ALLOWED_IPS=
RATE_LIMIT_REDIS_URL=

# Academic risk policy thresholds used by AI Copilot risk detection.
ACADEMIC_RISK_GRADE_THRESHOLD=60
ACADEMIC_SEVERE_RISK_GRADE_THRESHOLD=50

# Optional dev/stage read-only DB explorer (enabled via docker compose profile devtools)
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=ops@local.dev
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# LDAP/AD (optional in local, required in enterprise deployments)
AUTH_LDAP_ENABLED=false
LDAP_SERVER_URI=ldap://ad.example.local:389
LDAP_BIND_DN=CN=svc_bind,OU=ServiceAccounts,DC=example,DC=local
LDAP_BIND_PASSWORD=change_me
LDAP_BASE_DN=DC=example,DC=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
LDAP_LOGIN_ATTRIBUTE=sAMAccountName
LDAP_GROUP_ATTRIBUTE=memberOf
LDAP_GROUP_ROLE_MAP_JSON={}
LDAP_GROUP_ROLE_MAP_FILE=./ldap_group_role_map.example.json
LDAP_DEFAULT_ROLE=student
LDAP_TIMEOUT_SECONDS=5

# AI providers (set only what you use)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_CUSTOM_PROVIDER_URL=
AI_CUSTOM_PROVIDER_API_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=8

# Backup/restore (profiles and allowed roots for backup files)
BACKUP_DEFAULT_PROFILE=local
BACKUP_ALLOWED_ROOTS=/tmp/app-backups,/var/backups/app
BACKUP_PROFILES_JSON=[{"id":"local","label":"Local backup volume","path":"/tmp/app-backups/local"},{"id":"archive","label":"Archive backup volume","path":"/tmp/app-backups/archive"}]
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_MIN_FILES=3

# Grafana (devtools profile — required, no default)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
GRAFANA_PORT=3001
GRAFANA_BIND_ADDRESS=127.0.0.1

# Runtime schema bootstrap: set to false to rely on Alembic migrations (recommended)
RUNTIME_SCHEMA_BOOTSTRAP_ENABLED=false
