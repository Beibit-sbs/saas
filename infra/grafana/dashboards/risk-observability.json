{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "F1 AI Early-Warning risk pipeline observability dashboard.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Risk Scoring Success / min",
      "type": "stat",
      "targets": [
        { "expr": "sum(rate(risk_scoring_jobs_total{status=\"success\"}[5m])) * 60", "legendFormat": "success/min", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red" }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 5 } ] } } }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Risk Scoring Errors / min",
      "type": "stat",
      "targets": [
        { "expr": "sum(rate(risk_scoring_jobs_total{status=\"error\"}[5m])) * 60", "legendFormat": "errors/min", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } } }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Risk Scoring p95 (s)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(risk_scoring_duration_seconds_bucket{status=\"success\"}[10m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 } ] } } }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Max Snapshot Age (h)",
      "type": "stat",
      "targets": [
        { "expr": "max(risk_latest_snapshot_age_seconds) / 3600", "legendFormat": "hours", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "h", "thresholds": { "mode": "absolute", "steps": [ { "color": "green" }, { "color": "yellow", "value": 12 }, { "color": "red", "value": 24 } ] } } }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Risk Scoring Outcomes by Tenant",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (tenant_id, status) (rate(risk_scoring_jobs_total[5m]))", "legendFormat": "tenant={{tenant_id}} status={{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Risk Recommendation ACK by Outcome",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (tenant_id, status) (rate(risk_recommendation_ack_total[5m]))", "legendFormat": "tenant={{tenant_id}} status={{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Risk Scoring p50/p95/p99",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(risk_scoring_duration_seconds_bucket{status=\"success\"}[10m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(risk_scoring_duration_seconds_bucket{status=\"success\"}[10m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(risk_scoring_duration_seconds_bucket{status=\"success\"}[10m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "High-Band Students by Tenant",
      "type": "timeseries",
      "targets": [
        { "expr": "risk_high_band_students_total", "legendFormat": "tenant={{tenant_id}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["platform", "risk", "f1", "observability"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "F1 Risk Pipeline — Observability",
  "uid": "f1-risk-observability-v1",
  "version": 1
}
