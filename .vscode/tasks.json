{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker-up",
      "type": "shell",
      "command": "docker compose --env-file .env up -d --build",
      "options": { "cwd": "${workspaceFolder}/infra" }
    },
    {
      "label": "docker-down",
      "type": "shell",
      "command": "docker compose --env-file .env down",
      "options": { "cwd": "${workspaceFolder}/infra" }
    },
    {
      "label": "test-backend",
      "type": "shell",
      "command": "docker compose --env-file .env run --rm backend-tests pytest -q",
      "options": { "cwd": "${workspaceFolder}/infra" }
    },
    {
      "label": "lint-backend",
      "type": "shell",
      "command": "docker compose --env-file .env exec -T backend ruff check .",
      "options": { "cwd": "${workspaceFolder}/infra" }
    },
    {
      "label": "lint-frontend",
      "type": "shell",
      "command": "docker compose --env-file .env run --rm frontend-tests npm run lint",
      "options": { "cwd": "${workspaceFolder}/infra" }
    },
    {
      "label": "test-frontend",
      "type": "shell",
      "command": "docker compose --env-file .env run --rm frontend-tests npm run test:frontend",
      "options": { "cwd": "${workspaceFolder}/infra" }
    },
    {
      "label": "docker-logs",
      "type": "shell",
      "command": "docker compose --env-file .env logs -f --tail=100",
      "options": { "cwd": "${workspaceFolder}/infra" }
    }
  ]
}
