{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-backend",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" }
    },
    {
      "label": "run-frontend",
      "type": "shell",
      "command": "bash -lc 'export NVM_DIR=\"$HOME/.nvm\"; [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\"; nvm use --lts >/dev/null 2>&1 || true; npm run dev'",
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "test-backend",
      "type": "shell",
      "command": "pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" }
    },
    {
      "label": "lint-backend",
      "type": "shell",
      "command": "ruff check .",
      "options": { "cwd": "${workspaceFolder}/backend" }
    },
    {
      "label": "docker-up",
      "type": "shell",
      "command": "docker compose --env-file .env up -d --build",
      "options": { "cwd": "${workspaceFolder}/infra" }
    },
    {
      "label": "docker-down",
      "type": "shell",
      "command": "docker compose --env-file .env down",
      "options": { "cwd": "${workspaceFolder}/infra" }
    },
    {
      "label": "docker-logs",
      "type": "shell",
      "command": "docker compose --env-file .env logs -f --tail=100",
      "options": { "cwd": "${workspaceFolder}/infra" }
    }
  ]
}
